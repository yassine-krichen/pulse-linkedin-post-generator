# ── Database ──────────────────────────────────────────────────────────────────
# Postgres (Neon) connection string — same value for local dev and Render deployment
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# ── LLM provider selection ──────────────────────────────────────────────────
# "bridge" (local dev — drives claude.ai/chatgpt.com via your logged-in browser
#   session through the llm-web-bridge sibling project, free, no API costs) or
# "freellmapi" (deployed/production — hosted OpenAI-compatible multi-provider proxy)
LLM_PROVIDER=bridge

# ── llm-bridge (used when LLM_PROVIDER=bridge) ──────────────────────────────
# Local server from the llm-web-bridge sibling project. Start it separately.
LLM_BRIDGE_URL=http://127.0.0.1:3000
LLM_BRIDGE_API_KEY=
LLM_BRIDGE_PROVIDER=claude

# ── freellmapi (used when LLM_PROVIDER=freellmapi, or as bridge fallback) ───
FREELLM_BASE_URL=https://freellmapi-19vj.onrender.com/v1
FREELLM_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Reserved for a future trending-topics web search feature — not currently
# used anywhere in the codebase. Safe to leave unset.
BRAVE_SEARCH_API_KEY=

# ── Access control ───────────────────────────────────────────────────────
# Shared password that gates the entire app (this is a personal, single-user
# tool with no user accounts). Unset = no gate in local dev; unset in
# production is a hard failure (fail closed, see src/proxy.ts).
APP_PASSWORD=
