# ── Database ──────────────────────────────────────────────────────────────────
# Postgres (Neon) connection string — same value for local dev and Render deployment
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# ── LLM — llm-web-bridge ───────────────────────────────────────────────────
# Local Fastify server that drives claude.ai / chatgpt.com via browser automation.
# Start it: cd ../llm-web-bridge && npm start
BRIDGE_URL=http://127.0.0.1:3000
# Optional: matches the API_KEY env var set in the bridge process
BRIDGE_API_KEY=
# "claude" or "chatgpt"
BRIDGE_PROVIDER=claude
