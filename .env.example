# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite file in project root
DATABASE_URL="file:./dev.db"
# Render deployment: SQLite on persistent disk at /var/data
# DATABASE_URL="file:/var/data/prod.db"

# ── LLM — Gemini (primary) ───────────────────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
# Add multiple keys for rotation (if one hits quota, the next is tried)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash

# ── LLM — Groq (fallback) ────────────────────────────────────────────────────
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM — Ollama (last resort, local only) ───────────────────────────────────
# Install: https://ollama.com — pull a model first: `ollama pull llama3.2`
# Leave blank in production; only used when all Gemini + Groq keys are exhausted
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
