# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite file in project root
DATABASE_URL="file:./dev.db"
# Render deployment: SQLite on persistent disk at /var/data
# DATABASE_URL="file:/var/data/prod.db"

# ── LLM — claude-web-bridge ───────────────────────────────────────────────────
# Local Fastify server that drives claude.ai / chatgpt.com via browser automation.
# Start it: cd ../claude-web-bridge && npm start
BRIDGE_URL=http://127.0.0.1:3000
# Optional: matches the API_KEY env var set in the bridge process
BRIDGE_API_KEY=
# "claude" or "chatgpt"
BRIDGE_PROVIDER=claude
